---
import Head from "~components/Head.astro";
import Navigation from "~components/Navigation.astro";
import Footer from "~components/Footer.astro";
import { Time } from "~components/elements";
import "~styles/global.css";
import "~styles/markdown.css";
import "katex/dist/katex.min.css";

interface Props {
    title: string;
    description?: string;
    publicationDate: Date;
    remarkPluginFrontmatter?: Record<string, string>;
    [key: string]: unknown;
}
const { title, description, publicationDate, remarkPluginFrontmatter } = Astro.props;
---

<html lang="en">
    <Head title={title} description={description ?? remarkPluginFrontmatter?.description ?? ""} />

    <body>
        <Navigation />
        <main>
            <article>
                <header>
                    <Time date={publicationDate} format="D MMMM YYYY" />
                    <h1>{title}</h1>
                </header>

                <slot />
            </article>
        </main>

        <Footer />
    </body>
</html>

<style>
    header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    h1 {
        margin: 0;
        text-align: center;
    }
</style>
