---
import { getCollection } from "astro:content";
import Layout from "~layouts/Layout.astro";
import { H1, Time } from "~components/elements";

const SITE_TITLE = "writing | yalin.io";
const SITE_DESCRIPTION = "things i've written on various topics that interest me";

const writing = (await getCollection("writing")).sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <H1>Writing</H1>

    <ul>
        {
            writing.map((i) => (
                <li>
                    <code>
                        <Time date={i.data.publicationDate} format="YYYY-MM" />
                    </code>
                    <a href={`/writing/${i.id}/`}>{i.data.title}</a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    ul {
        padding: 0;
        margin: 0;
    }

    li {
        padding: 0;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    li {
        list-style-type: none;
    }

    code {
        color: var(--color-grey);
    }
</style>
