---
import { Image } from "astro:assets";

import Layout from "~layouts/Layout.astro";
import identicon from "~assets/identicon.png";

const SITE_TITLE = "about | yalin.io";
const SITE_DESCRIPTION = "about";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="profile">
        <Image alt="identicon" src={identicon} height="100" width="100" />
        <div class="text">
            <div class="name">Berkay Yalin</div>
            <div class="username">ostromia</div>
        </div>
    </div>

    <div class="social">
        <a href="https://github.com/ostromia">github.com/ostromia</a>
        <a href="https://gitlab.com/ostromia">gitlab.com/ostromia</a>
        <a href="https://codeberg.org/ostromia">codeberg.org/ostromia</a>
    </div>

    <div class="social">
        <a href="https://pypi.org/user/ostromia/">pypi.org/user/ostromia</a>
        <a href="https://www.npmjs.com/~ostromia">npmjs.com/~ostromia</a>
        <a href="https://crates.io/users/ostromia">crates.io/users/ostromia</a>
    </div>

    <div class="social">
        <a href="https://monkeytype.com/profile/ostromia">monkeytype.com/profile/ostromia</a>
    </div>
</Layout>

<style>
    .profile,
    .social {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        border-radius: 5px;
        background-color: var(--foreground-color);
    }

    .profile {
        flex-direction: row;

        .text {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 0.5rem;

            .name {
                font-size: 1.25rem;
            }

            .username {
                color: var(--color-grey);
            }
        }
    }

    .social {
        flex-direction: column;
    }
</style>
