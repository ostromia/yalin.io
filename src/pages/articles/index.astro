---
import { getCollection } from "astro:content";
import Layout from "~layouts/Layout.astro";
import { H1, Time } from "~components/elements";

const SITE_TITLE = "articles | yalin.io";
const SITE_DESCRIPTION = "articles i've written";

const posts = (await getCollection("articles")).sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <H1>Articles</H1>

    <ul>
        {
            posts.map((post) => (
                <li>
                    <code>
                        <Time date={post.data.publicationDate} format="YYYY-MM" />
                    </code>
                    <a href={`/articles/${post.id}/`}>{post.data.title}</a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    ul {
        padding: 0;
    }

    li {
        padding: 0;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    li {
        list-style-type: none;
    }

    code {
        color: var(--color-grey);
    }
</style>
