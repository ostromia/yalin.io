---
import repositories from "~assets/projects/repositories.json";
import websites from "~assets/projects/websites.json";
import { H1 } from "~components/elements";
import RepositoryCard from "~components/RepositoryCard.astro";
import WebsiteCard from "~components/WebsiteCard.astro";
import Layout from "~layouts/Layout.astro";

import _0001 from "~assets/projects/0001.webp";
import _0002 from "~assets/projects/0002.webp";
import _0003 from "~assets/projects/0003.webp";

const SITE_TITLE = "projects | yalin.io";
const SITE_DESCRIPTION = "projects i've been working on";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <section>
        <H1>Websites</H1>
        <div class="websites">
            <WebsiteCard title="Zygon" path="https://ostromia.github.io/zygon" image={_0001.src} />
            <WebsiteCard
                title="A Mann's Backpack"
                path="https://ostromia.github.io/amannsbackpack"
                image={_0002.src}
            />
            <WebsiteCard
                title="Gents & Ginger"
                path="https://gentsandginger.com"
                image={_0003.src}
            />
        </div>
    </section>

    <section>
        <H1>Projects</H1>
        {repositories.projects.map((e) => (
            <RepositoryCard path={e.full_name} description={e.description} language={e.languages} />
        ))}
    </section>

    <section>
        <H1>Other Repositories</H1>
        {repositories.other.map((e) => (
            <RepositoryCard path={e.full_name} description={e.description} language={e.languages} />
        ))}
    </section>
</Layout>

<style>
    .websites {
        display: flex;
        flex-wrap: wrap-reverse;
        gap: 1rem;
    }

    ul,
    li {
        margin: 0;
        padding: 0;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    li {
        list-style-type: none;
    }

    .date {
        color: var(--color-grey);
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    section:nth-of-type(2) {
        padding: 2rem 0;
    }
</style>
